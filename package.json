{
  "name": "evolution-sim",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "A browser-based artificial-life simulation where roles like predator and herbivore emerge from energy economics.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "build": "npm run build -w apps/viewer",
    "dev": "npm run dev -w apps/viewer",
    "sim": "npm run start -w apps/runner --",
    "bench": "npm run bench -w apps/runner",
    "gif": "npm run gif -w apps/runner --",
    "exp": "npm run exp -w apps/runner --"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
